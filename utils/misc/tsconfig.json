{
  "compilerOptions": {
    "outDir": "./built",
    "rootDir": "./src",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "allowJs": true,
    "checkJs": false,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "moduleResolution": "nodenext",
    "module": "nodenext",
    "skipLibCheck": true,
    "strict": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "built", "**/*.test.mts"]
}
